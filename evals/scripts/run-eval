#!/usr/bin/env bash
#
# Run one eval: copy a fixture, drive a headless session over it, record
# provenance, and score what came out.
#
# Two modes:
#   --mode audit      (default) drive a full audit; score findings.yaml
#                     against the fixture's ground truth.
#   --mode remediate  drive a remediation session against the PRIOR audit
#                     the fixture ships; score the ledger, the git history
#                     since `eval-baseline`, and a set of held-out
#                     cross-module tests the session never saw.
#
# The RUNNER records platform/model/effort — provenance is never
# self-reported by the model. Results land in:
#   evals/runs/<fixture>/<timestamp>-<platform>-<model>-<effort>[-remediate]/
#
# Usage:
#   run-eval [--mode audit|remediate] [--platform claude|codex] [--model MODEL]
#            [--effort EFFORT] [--isolation sandbox|none] <fixture>
#
# TRUST LEVEL. The session reads a repository and acts on what it reads,
# which is exactly the shape prompt injection targets, and the scorer then
# trusts artifacts that session wrote. The runner assumes ONE operator and
# FIRST-PARTY fixtures under evals/fixtures/. Do not point it at a
# third-party repository without reading the isolation notes below.
#
#   --isolation sandbox  (default) the harness's own OS sandbox: on the
#                        claude platform, seatbelt (macOS) / bubblewrap
#                        (Linux) confines writes to the workspace and the
#                        scratch dirs listed in SANDBOX_SETTINGS; codex runs
#                        under `-s workspace-write`. Tool calls are still
#                        limited to ALLOWED_TOOLS.
#   --isolation none     no OS confinement; the session runs with the
#                        operator's full user rights, gated only by the
#                        ALLOWED_TOOLS command-prefix allowlist. Use it when
#                        a fixture needs something the sandbox refuses, and
#                        say so in the run notes.
#
# CASED_EVAL_ISOLATION in the environment sets the default for both.
#
# Each run is a full multi-agent session: expect minutes and real token
# spend. Run matrices deliberately, not in CI-per-push.

set -euo pipefail

EVALS_DIR="$(cd "$(dirname "$0")/.." && pwd)"
REPO_ROOT="$(cd "$EVALS_DIR/.." && pwd)"

PLATFORM="claude"
MODEL="default"
EFFORT="default"
MODE="audit"
ISOLATION="${CASED_EVAL_ISOLATION:-sandbox}"
FIXTURE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --platform)  PLATFORM="$2"; shift 2 ;;
    --model)     MODEL="$2"; shift 2 ;;
    --effort)    EFFORT="$2"; shift 2 ;;
    --mode)      MODE="$2"; shift 2 ;;
    --isolation) ISOLATION="$2"; shift 2 ;;
    --help|-h)
      grep '^#' "$0" | grep -v '^#!' | sed 's/^# \{0,1\}//' >&2
      exit 0
      ;;
    -*) echo "unknown option: $1" >&2; exit 1 ;;
    *)  FIXTURE="$1"; shift ;;
  esac
done

case "$MODE" in
  audit|remediate) ;;
  *) echo "error: --mode must be audit or remediate (got '$MODE')" >&2; exit 1 ;;
esac

case "$ISOLATION" in
  sandbox|none) ;;
  *) echo "error: --isolation must be sandbox or none (got '$ISOLATION')" >&2; exit 1 ;;
esac

if [[ -z "$FIXTURE" ]]; then
  echo "error: fixture name required (see evals/fixtures/)" >&2
  exit 1
fi

FIXTURE_DIR="$EVALS_DIR/fixtures/$FIXTURE"
if [[ ! -d "$FIXTURE_DIR" ]]; then
  echo "error: no fixture at $FIXTURE_DIR" >&2
  exit 1
fi

TS="$(TZ='America/New_York' date +%Y-%m-%d-%H%M%S)"
RUN_SLUG="$TS-$PLATFORM-$MODEL-$EFFORT"
[[ "$MODE" == "remediate" ]] && RUN_SLUG="$RUN_SLUG-remediate"
RUN_DIR="$EVALS_DIR/runs/$FIXTURE/$RUN_SLUG"
WORKDIR="$RUN_DIR/workdir"
mkdir -p "$WORKDIR"

# Fresh copy of the fixture, minus ground truth — the model must never see
# expected-findings.yaml, the history-building script (which spells out every
# seed), or the hidden tests a remediation run is scored against.
rsync -a --exclude expected-findings.yaml --exclude target \
  --exclude setup.sh --exclude hidden-tests "$FIXTURE_DIR/" "$WORKDIR/"

# cargo-audit's advisory-db fetch does not go through the sandbox's network
# proxy (observed: "IO error talking to the server" for github.com while
# cargo's own registry fetch and cargo-deny both succeed). So under sandbox
# isolation the runner refreshes the advisory DB HERE, outside the wall, and
# tells the session's cargo-audit not to fetch via a project-local
# .cargo/audit.toml. The file lands in the baseline commit, so recon sees one
# config file the fixture did not ship; a fixture that ships its own is left
# alone. `-f` points the refresh at the workdir lockfile from RUN_DIR, which
# has no audit.toml, so this invocation still fetches.
if [[ "$ISOLATION" == "sandbox" && -f "$WORKDIR/Cargo.lock" ]]; then
  if command -v cargo-audit >/dev/null 2>&1; then
    (cd "$RUN_DIR" && cargo audit -q -f "$WORKDIR/Cargo.lock" >/dev/null 2>&1) \
      || echo "warn: advisory-db refresh failed; the session's cargo audit will run stale" >&2
  fi
  if [[ ! -e "$WORKDIR/.cargo/audit.toml" ]]; then
    mkdir -p "$WORKDIR/.cargo"
    printf '[database]\nfetch = false\nstale = true\n' > "$WORKDIR/.cargo/audit.toml"
  fi
fi

# The audit expects a git repo (recon runs git log for churn data).
git -C "$WORKDIR" init -q
git -C "$WORKDIR" add -A
git -C "$WORKDIR" -c user.name=eval -c user.email=eval@local commit -qm "fixture baseline"

# A fixture whose seeds live in git history (prior audit, ledgered fixes,
# regressions) builds that history itself. setup.sh owns the workdir's repo
# from here — it may rewrite the baseline commit — and writes sha-map.json
# so the scorer can resolve caused-by-fix claims to real commits.
# Tested with -f, not -x: a fixture that lost its exec bit (a fresh clone, a
# zip round-trip) would otherwise skip history-building in silence and score
# an audit against the wrong tree.
if [[ -f "$FIXTURE_DIR/setup.sh" ]]; then
  RUN_DIR="$RUN_DIR" bash "$FIXTURE_DIR/setup.sh" "$WORKDIR"
fi

# The state the audit starts from, tagged so remediation evals can diff
# against it after the fact.
git -C "$WORKDIR" tag eval-baseline

# Remediation targets the audit the FIXTURE shipped, resolved before the
# session runs. Resolving it afterwards would let a session that decided to
# run a fresh audit redirect the scorer at its own output.
PRIOR_AUDIT_DIR=""
if [[ "$MODE" == "remediate" ]]; then
  PRIOR_FINDINGS="$(find "$WORKDIR/record/audits" -name findings.yaml 2>/dev/null | sort | tail -1)"
  if [[ -z "$PRIOR_FINDINGS" ]]; then
    echo "error: --mode remediate needs a fixture that ships a prior audit under record/audits/" >&2
    exit 1
  fi
  PRIOR_AUDIT_DIR="$(dirname "$PRIOR_FINDINGS")"
  if [[ ! -d "$FIXTURE_DIR/hidden-tests" ]]; then
    echo "error: --mode remediate needs $FIXTURE_DIR/hidden-tests/ (the held-out contract suite)" >&2
    exit 1
  fi
fi

# Snapshot the findings.yaml files that exist BEFORE the session runs. A
# fixture that ships a prior audit already has one; if the session writes
# nothing, the post-session `sort | tail -1` would silently hand the scorer
# that pre-existing audit and score it as this run's output.
PRE_EXISTING_FINDINGS="$(find "$WORKDIR/record/audits" -name findings.yaml 2>/dev/null | sort || true)"

CASED_COMMIT="$(git -C "$REPO_ROOT" rev-parse --short HEAD)"
STARTED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

if [[ "$MODE" == "remediate" ]]; then
  # Deliberately says nothing about which findings are real, which are
  # baits, or how many should end up fixed — the disposition decision is
  # what's under test.
  PROMPT="Use the cased skill. Resolve the findings from the latest audit in record/audits/ (read its AGENTS.md first). Work through every open finding: decide the disposition first, remediate what should be remediated, verify at workspace scope, and record every action in actions-taken.md. Do not ask for confirmation; proceed to completion."
else
  PROMPT="Use the cased skill to run a full audit of this project. Scope: full repo. Do not ask for scope confirmation or tool selection — use defaults and proceed to completion, including verification and assembly."
fi

# Tools the audit pipeline needs. Declared explicitly so the run survives
# CLAUDE_CODE_SUBPROCESS_ENV_SCRUB hardening, which forces permission mode
# back to default and would otherwise auto-deny every tool call headlessly.
#
# Bash is allowlisted by command prefix, not blanket: the pipeline runs the
# recon wrapper (bash), build-report (node), the workspace gates (cargo,
# just), tokei, and git, plus the read-only shell idioms auditors reach for
# (ls, wc, find, grep, head, tail, diff, mkdir for the audit dir). A prefix
# not in this list is auto-denied headlessly, which stalls the audit
# visibly in the transcript rather than silently widening what it may run.
# Extend the list when a legitimate command shows up denied; do not put
# `Bash` back.
ALLOWED_TOOLS="Read,Write,Edit,Glob,Grep,Task,Skill,TodoWrite"
for prefix in bash node cargo just tokei git ls wc find grep rg head tail diff mkdir; do
  ALLOWED_TOOLS="$ALLOWED_TOOLS,Bash($prefix:*)"
done

# Sandbox policy for the claude platform. Three settings carry the weight:
#   allowUnsandboxedCommands=false — by default a command that hits the
#     sandbox wall may be retried OUTSIDE it, and in headless acceptEdits
#     that retry runs with no prompt. Off, the wall is final.
#   failIfUnavailable=true — a host without seatbelt/bubblewrap fails the
#     run instead of silently degrading to --isolation none.
#   strictAllowlist=true — an unlisted domain is denied, not prompted.
# Writes: the workspace (cwd) and $TMPDIR are allowed implicitly; the cased
# scratch root and cargo's registry/advisory caches are added so `cargo
# audit`/`cargo test` and the skill's scratch policy work inside the wall.
# Network: crates.io and GitHub for cargo fetches and advisory DBs. The
# model API is the harness's own process, not a Bash child, so it is
# unaffected.
SANDBOX_SETTINGS='{"sandbox":{"enabled":true,"failIfUnavailable":true,"autoAllowBashIfSandboxed":true,"allowUnsandboxedCommands":false,"filesystem":{"allowWrite":["/private/tmp/cased","~/.cargo/registry","~/.cargo/.package-cache","~/.cargo/.global-cache","~/.cargo/advisory-db","~/.cargo/advisory-db..lock","~/.cargo/advisory-dbs"]},"network":{"allowedDomains":["crates.io","*.crates.io","github.com","*.github.com","*.githubusercontent.com"],"strictAllowlist":true}}}'

case "$PLATFORM" in
  claude)
    CMD=(claude -p "$PROMPT" --output-format text --permission-mode acceptEdits --allowedTools "$ALLOWED_TOOLS")
    [[ "$ISOLATION" == "sandbox" ]] && CMD+=(--settings "$SANDBOX_SETTINGS")
    [[ "$MODEL" != "default" ]] && CMD+=(--model "$MODEL")
    ;;
  codex)
    # Per README multi-platform setup: codex needs the tool-mapping
    # reference loaded or Phase 2 collapses to sequential analysis.
    # multi_agent is forced on so dispatch never depends on local config.
    # workspace-write + network lets cargo-audit/deny fetch advisory DBs.
    CODEX_PROMPT="$PROMPT When invoking the cased skill, read its references/codex-tools.md before dispatching subagents."
    # --ephemeral + --ignore-user-config keep the run hermetic: no user
    # MCP servers or memory features recalling past audit sessions (a
    # live run was observed surfacing other repos' cased audits), no
    # session state persisted to seed future runs. Auth still works;
    # everything the eval needs (multi_agent, model, sandbox) is forced
    # explicitly below.
    CMD=(codex exec --skip-git-repo-check
         --ephemeral --ignore-user-config
         --enable multi_agent)
    if [[ "$ISOLATION" == "sandbox" ]]; then
      CMD+=(-s workspace-write -c 'sandbox_workspace_write.network_access=true')
    else
      CMD+=(-s danger-full-access)
    fi
    CMD+=("$CODEX_PROMPT")
    [[ "$MODEL" != "default" ]] && CMD+=(--model "$MODEL")
    [[ "$EFFORT" != "default" ]] && CMD+=(-c "model_reasoning_effort=\"$EFFORT\"")
    ;;
  *)
    echo "error: platform '$PLATFORM' not wired yet (add a case here)" >&2
    exit 1
    ;;
esac

echo "run-eval: $FIXTURE on $PLATFORM/$MODEL/$EFFORT ($MODE)" >&2
echo "  workdir:   $WORKDIR" >&2
if [[ "$ISOLATION" == "none" ]]; then
  echo "  isolation: NONE — session runs with your full user rights, gated only by the command-prefix allowlist" >&2
else
  echo "  isolation: sandbox (writes confined to the workspace and scratch dirs)" >&2
fi
( cd "$WORKDIR" && "${CMD[@]}" ) | tee "$RUN_DIR/transcript.txt" >&2 || {
  echo "error: $MODE run failed; transcript in $RUN_DIR/transcript.txt" >&2
  exit 1
}

FINISHED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

if [[ "$MODE" == "remediate" ]]; then
  FINDINGS="$PRIOR_AUDIT_DIR/findings.yaml"
else
  # A fixture that ships a prior audit leaves more than one findings.yaml under
  # record/audits/. Audit directories are date-prefixed (YYYY-MM-DD-HH-slug), so
  # the lexically last one is the audit this run produced — the same ordering
  # findPriorAudits() uses to pick the newest prior audit.
  FINDINGS="$(find "$WORKDIR/record/audits" -name findings.yaml 2>/dev/null | sort | tail -1)"
  if [[ -z "$FINDINGS" ]]; then
    echo "error: no findings.yaml produced under $WORKDIR/record/audits/" >&2
    exit 1
  fi
  # …and if the pick is one of the files that were already there, the session
  # produced no audit of its own. Scoring the fixture's shipped prior audit
  # would report a passing run for a session that did nothing.
  if [[ -n "$PRE_EXISTING_FINDINGS" ]] \
     && grep -qxF "$FINDINGS" <<<"$PRE_EXISTING_FINDINGS"; then
    echo "error: no new audit produced (only pre-existing: $(echo "$PRE_EXISTING_FINDINGS" | tr '\n' ' '))" >&2
    exit 1
  fi
fi

# Workspace hygiene: the workdir was committed at baseline, so anything
# outside the sanctioned output set is agent litter (scratch notes,
# review dumps, temp scripts, ghost artifacts). Observed in the wild:
# review-N.md files in audit dirs; an unreferenced terrain-map.svg from
# a deprecated report format. The audit dir is NOT blanket-sanctioned —
# only the enumerated File Inventory artifacts are. -uall matters:
# without it, porcelain collapses untracked directories and hides every
# file inside them.
#
# This runs BEFORE the held-out tests are copied in, so tests/contract.rs
# never has to be special-cased as sanctioned. In remediate mode a modified
# source file showing up here is itself a signal: the briefing asks for one
# focused commit per fix, so uncommitted edits mean the work was not landed.
SANCTIONED='^record/audits/[^/]+/(README\.md|report\.html|AGENTS\.md|CLAUDE\.md|recon\.yaml|findings\.yaml|actions-taken\.md|assets/sparkline-[^/]+\.svg)$'
STRAYS="$(git -C "$WORKDIR" status --porcelain -uall \
  | sed 's/^...//' \
  | grep -vE '^(\.crustoleum/|target/)' \
  | grep -vE "$SANCTIONED" || true)"
STRAY_COUNT=0
[[ -n "$STRAYS" ]] && STRAY_COUNT="$(echo "$STRAYS" | wc -l | tr -d ' ')"

HIDDEN_RESULT=""
if [[ "$MODE" == "remediate" ]]; then
  # The held-out contract suite. It was excluded from the rsync, so the
  # session never saw it, could not run it, and could not tune against it.
  # It goes in now, runs once, and comes straight back out: leaving it in
  # tests/ would fold its result into the workspace gate the scorer runs
  # next, and the two measurements answer different questions.
  mkdir -p "$WORKDIR/tests"
  HIDDEN_FILES=()
  HIDDEN_TARGETS=()
  for f in "$FIXTURE_DIR"/hidden-tests/*.rs; do
    [[ -f "$f" ]] || { echo "error: $FIXTURE_DIR/hidden-tests/ holds no .rs files" >&2; exit 1; }
    cp "$f" "$WORKDIR/tests/"
    HIDDEN_FILES+=("$WORKDIR/tests/$(basename "$f")")
    HIDDEN_TARGETS+=("$(basename "$f" .rs)")
  done
  echo "run-eval: running held-out contract tests (${HIDDEN_TARGETS[*]})" >&2
  HIDDEN_RESULT="pass"
  : >"$RUN_DIR/hidden-tests.txt"
  for t in "${HIDDEN_TARGETS[@]}"; do
    ( cd "$WORKDIR" && cargo test --test "$t" ) >>"$RUN_DIR/hidden-tests.txt" 2>&1 \
      || HIDDEN_RESULT="fail"
  done
  echo "  hidden tests: $HIDDEN_RESULT ($RUN_DIR/hidden-tests.txt)" >&2
  rm -f "${HIDDEN_FILES[@]}"

  # Ledger lint is evidence, not a gate — a ledger with errors is exactly the
  # outcome this eval exists to measure, so a non-zero exit must not abort.
  ( cd "$WORKDIR" && node "$REPO_ROOT/src/viewer/build-report.mjs" ledger "$PRIOR_AUDIT_DIR" ) \
    >"$RUN_DIR/ledger-lint.txt" 2>&1 || true
  echo "  ledger lint: $RUN_DIR/ledger-lint.txt" >&2
fi

cat > "$RUN_DIR/run-meta.yaml" <<EOF
fixture: $FIXTURE
mode: $MODE
platform: $PLATFORM
model: $MODEL
effort: $EFFORT
cased_commit: $CASED_COMMIT
started: $STARTED
finished: $FINISHED
findings: ${FINDINGS#"$RUN_DIR/"}
stray_file_count: $STRAY_COUNT
EOF
[[ -n "$HIDDEN_RESULT" ]] && echo "hidden_tests: $HIDDEN_RESULT" >> "$RUN_DIR/run-meta.yaml"
if [[ -n "$STRAYS" ]]; then
  {
    echo "stray_files:"
    echo "$STRAYS" | sed 's/^/  - /'
  } >> "$RUN_DIR/run-meta.yaml"
  echo "hygiene: $STRAY_COUNT stray file(s) left by agents:" >&2
  echo "$STRAYS" | sed 's/^/  /' >&2
fi

AUDIT_DIR="$(dirname "$FINDINGS")"

if [[ "$MODE" == "remediate" ]]; then
  # Remediation is scored off the ledger, the git history since
  # eval-baseline, and the held-out tests — not off findings.yaml, which the
  # session was told to treat as immutable.
  SCORE_ARGS=(--mode remediate --audit-dir "$AUDIT_DIR" --repo-root "$WORKDIR"
              --hidden-tests-result "$HIDDEN_RESULT"
              --hidden-tests-output "$RUN_DIR/hidden-tests.txt")
  node "$EVALS_DIR/scripts/score-eval.mjs" "$FIXTURE_DIR" "${SCORE_ARGS[@]}" --json \
    > "$RUN_DIR/score.json"
  node "$EVALS_DIR/scripts/score-eval.mjs" "$FIXTURE_DIR" "${SCORE_ARGS[@]}" \
    | tee "$RUN_DIR/score.txt"
else
  # Artifact scoring reads the whole audit directory (README completeness,
  # audit_profile, evidence fidelity, the finalize gates) against the tree the
  # audit actually ran on; --sha-map lets the re-audit metrics check
  # caused-by-fix refs against the commits setup.sh created.
  SCORE_ARGS=(--audit-dir "$AUDIT_DIR" --repo-root "$WORKDIR")
  [[ -f "$RUN_DIR/sha-map.json" ]] && SCORE_ARGS+=(--sha-map "$RUN_DIR/sha-map.json")

  node "$EVALS_DIR/scripts/score-eval.mjs" "$FIXTURE_DIR" "$FINDINGS" "${SCORE_ARGS[@]}" --json \
    > "$RUN_DIR/score.json"
  node "$EVALS_DIR/scripts/score-eval.mjs" "$FIXTURE_DIR" "$FINDINGS" "${SCORE_ARGS[@]}" \
    | tee "$RUN_DIR/score.txt"
fi

echo "" >&2
echo "run recorded: $RUN_DIR" >&2
